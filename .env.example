# Required on Vercel production; use your verified canonical HTTPS domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
RESEND_API_KEY=
CONTACT_RECIPIENT_EMAIL=
CONTACT_SENDER_EMAIL=
# Optional Google Sheets storage; fill all three credentials to enable.
# Any partial configuration disables form submission instead of silently losing rows.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Copy private_key from the service account JSON; literal \n or real newlines work.
GOOGLE_PRIVATE_KEY=
GOOGLE_SPREADSHEET_ID=
# Optional tab name, defaults to Contacts. Leave blank in email-only mode.
GOOGLE_SHEET_NAME=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Additional allowed preview hostname; comma-separated, exact hostnames only.
TURNSTILE_ALLOWED_HOSTNAMES=
# Set true only after enabling a shared Vercel WAF rate-limit rule for POST /api/contact.
CONTACT_WAF_CONFIGURED=false
